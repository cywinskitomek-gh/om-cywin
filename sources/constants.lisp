(in-package :om)

;==================================================

(defvar *phi* (/ (1+ (expt 5 (coerce 1/2 'double-float))) 2))

(defvar *semitone* (expt 2 (coerce 1/12 'double-float)))

(defun phi ()
  "Golden ratio phi (1.618...)." *phi*)

(defun 1/phi ()
  "1/phi (0.618...)." (/ *phi*))

(defun phi^2 ()
  "phi squared (2.618...)." (sqr *phi*))

(defun 1/phi^2 ()
  "1/phi squared (0.382...)." (/ (phi^2)))

(defun phi^n (n)
  "phi to the power n." (expt *phi* n))


(defun 1/phi^n (n)
  "1/phi to the power n." (/ (phi^n n)))

(defun pi ()
  "The number pi." pi)

(defun 2pi ()
  "2 pi." (+ pi pi))

(defvar *2pi* (2pi))

(defun e_const ()
  "Euler's number e (2.718...)." (exp (coerce 1 'double-float)))


(defun tempered-semitone ()
  "Frequency ratio of the tempered semitone (2^(1/12))." *semitone*)

(defun tempered-whole-tone ()
  "Frequency ratio of the tempered whole tone (2^(1/6))." (expt *semitone* 2))

(defun 1/tempered-semitone ()
  "Inverse of the tempered semitone ratio (2^(-1/12))." (/ *semitone*))

(defun 1/tempered-whole-tone ()
  "Inverse of the tempered whole tone ratio (2^(-1/6))." (/ (tempered-whole-tone)))

(defun cent ()
  "Frequency ratio of one cent (2^(1/1200))." (expt *semitone* 1/100))

(defun 1/cent ()
  "Inverse of the cent ratio (2^(-1/1200))." (/ (cent)))

